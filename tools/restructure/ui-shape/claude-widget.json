  "roots": [
    "[data-dashboard-widget=\"claude\"]",
    "body > .cw-overlay",
    "#toast-island"
  ],
  "background": [
    "^GET /network$",
    "^(GET|POST) /bit/messages",
    "^GET /index/status$",
    "^GET /api/community/",
    "^GET /audio$",
    "^GET /weather",
    "^GET /external-events$",
    "^GET /sdk/widgets$",
    "^POST /settings "
  ],
  "replace": [
    [
      "\\.is-glint",
      ""
    ],
    [
      "data-expires-at=\"[0-9]+\"",
      "data-expires-at=\"n\""
    ],
    [
      "[0-9]+:[0-9]{2} left",
      "m:ss left"
    ],
    [
      "\"(⎿ )?[0-9]+(d[0-9]+h|[smhd])\"",
      "\"$1n\""
    ],
    [
      "[0-9]+d[0-9]+h ago",
      "n ago"
    ],
    [
      "(animationend|transitionend):[0-9]+",
      "$1:n"
    ]
  ],
  "steps": [
    {
      "say": "the page has finished starting",
      "do": "wait",
      "ms": 3000
    },
    {
      "say": "the Claude Code tile is put on the dashboard",
      "do": "run",
      "code": "addWidgetToPage('claude', 'dashboard')"
    },
    {
      "say": "the tile has drawn the answered sessions and their decisions",
      "do": "wait",
      "ms": 3000
    },
    {
      "say": "the urgent question takes the Other row",
      "do": "click",
      "on": "body > .cw-overlay .cw-opt",
      "nth": 2
    },
    {
      "say": "an answer of its own is typed",
      "do": "fill",
      "on": "body > .cw-overlay .cw-dec-input",
      "text": "In a small queue file"
    },
    {
      "say": "the urgent question is answered",
      "do": "click",
      "on": "body > .cw-overlay .cw-key.is-allow"
    },
    {
      "say": "each face of the tile in turn",
      "do": "clickEach",
      "on": "[data-dashboard-widget=\"claude\"] .cw-face"
    },
    {
      "say": "back to the first face",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-face",
      "nth": 0
    },
    {
      "say": "each session of the rail in turn",
      "do": "clickEach",
      "on": "[data-dashboard-widget=\"claude\"] .cw-rc"
    },
    {
      "say": "the session with a plan to approve",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-rc:has-text(\"Search index\")"
    },
    {
      "say": "the plan is approved in its first mode",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-dec.is-plan .cw-opt",
      "nth": 0
    },
    {
      "say": "the session waiting for a permission",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-rc:has-text(\"Checkout totals\")"
    },
    {
      "say": "each view of the side panel",
      "do": "clickEach",
      "on": "[data-dashboard-widget=\"claude\"] .cw-aside-tab"
    },
    {
      "say": "an agent opens",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ag-row",
      "nth": 0
    },
    {
      "say": "the agent closes",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ag-back"
    },
    {
      "say": "the permission is denied",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-dec .cw-key.is-deny",
      "nth": 0
    },
    {
      "say": "a slash opens the session commands",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "/"
    },
    {
      "say": "the list of the session arrives",
      "do": "wait",
      "ms": 800
    },
    {
      "say": "the arrow moves down the list",
      "do": "press",
      "key": "ArrowDown"
    },
    {
      "say": "Escape closes the list",
      "do": "press",
      "key": "Escape"
    },
    {
      "say": "the model command offers its models",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "/model "
    },
    {
      "say": "a message is typed",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "Keep the receipts the same"
    },
    {
      "say": "the message is sent into the session",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-send"
    },
    {
      "say": "the header compacts the session",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-chip-btn"
    },
    {
      "say": "a new session is asked for",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-open"
    },
    {
      "say": "the projects arrive",
      "do": "wait",
      "ms": 800
    },
    {
      "say": "the second project is chosen",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-proj",
      "nth": 1
    },
    {
      "say": "a slash opens the commands of the project",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "/"
    },
    {
      "say": "the list of commands arrives",
      "do": "wait",
      "ms": 800
    },
    {
      "say": "the effort command offers its levels",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "/effort "
    },
    {
      "say": "a task for the new run is typed",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-text",
      "text": "Tidy the tests"
    },
    {
      "say": "the new run is started",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-send"
    },
    {
      "say": "another folder is offered",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-proj-add"
    },
    {
      "say": "a folder is typed",
      "do": "fill",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-folder-in",
      "text": "D:\\Sample\\nowhere"
    },
    {
      "say": "the folder is refused",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-ask-proj-go"
    },
    {
      "say": "the connection panel opens",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-name"
    },
    {
      "say": "the connection panel closes",
      "do": "click",
      "on": "[data-dashboard-widget=\"claude\"] .cw-panel-close"
    }
  ]
}
