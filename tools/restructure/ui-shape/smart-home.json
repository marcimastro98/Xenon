    {
      "say": "Settings opens on Smart Home",
      "do": "run",
      "code": "openSettingsCategory('smarthome')"
    },
    {
      "say": "Settings has drawn the devices",
      "do": "wait",
      "ms": 2500
    },
    {
      "say": "the device search is typed",
      "do": "fill",
      "on": "#settings-smarthome-hub .sh-set-input[type=search]",
      "text": "living"
    },
    {
      "say": "the device search is emptied",
      "do": "fill",
      "on": "#settings-smarthome-hub .sh-set-input[type=search]",
      "text": " "
    },
    {
      "say": "move button 2 of the order list",
      "do": "click",
      "on": "#settings-smarthome-hub .sh-ord-btn",
      "nth": 1
    },
    {
      "say": "the order list has been saved and drawn again (1)",
      "do": "wait",
      "ms": 1200
    },
    {
      "say": "move button 3 of the order list",
      "do": "click",
      "on": "#settings-smarthome-hub .sh-ord-btn",
      "nth": 2
    },
    {
      "say": "the order list has been saved and drawn again (2)",
      "do": "wait",
      "ms": 1200
    },
    {
      "say": "move button 6 of the order list",
      "do": "click",
      "on": "#settings-smarthome-hub .sh-ord-btn",
      "nth": 5
    },
    {
      "say": "the order list has been saved and drawn again (3)",
      "do": "wait",
      "ms": 1200
    },
    {
      "say": "move button 4 of the order list",
      "do": "click",
      "on": "#settings-smarthome-hub .sh-ord-btn",
      "nth": 3
    },
    {
      "say": "the order list has been saved and drawn again (4)",
      "do": "wait",
      "ms": 1200
    },
    {
      "say": "each checkbox of the device list",
      "do": "clickEach",
      "on": "#settings-smarthome-hub .sh-set-check input"
    },
    {
      "say": "each way of showing the devices",
      "do": "chooseEach",
      "on": "#settings-smarthome-hub select.settings-select"
    },
    {
      "say": "Connect asks the copy",
      "do": "click",
      "on": "#settings-smarthome-hub .settings-btn.primary"
    }
  ]
}
