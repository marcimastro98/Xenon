  "roots": [
    ".cst-overlay",
    ".cgal-zoom"
  ],
  "background": [
    "^GET /network$",
    "^(GET|POST) /bit/messages",
    "^GET /index/status$",
    "^GET /audio$",
    "^GET /weather",
    "^GET /external-events$",
    "^GET /sdk/widgets$",
    "^GET /api/community/catalog$",
    "^GET /api/community/limited-status",
    "^GET /api/community/supporter$",
    "^GET /api/community/trial$",
    "^POST /api/community/trial/",
    "^GET /api/community/messages",
    "^POST /settings "
  ],
  "replace": [
    [
      "[0-9]+ (min|h|s) ago",
      "n ago"
    ],
    [
      "\\.is-glint",
      ""
    ],
    [
      "(animationend|transitionend):[0-9]+",
      "$1:n"
    ]
  ],
  "steps": [
    {
      "say": "the page has finished starting and the Store dot has asked for the catalogue",
      "do": "wait",
      "ms": 6000
    },
    {
      "say": "the Store opens",
      "do": "run",
      "code": "window.CommunityGallery.open()"
    },
    {
      "say": "the Store has drawn its home",
      "do": "wait",
      "ms": 2500
    },
    {
      "say": "every view of the rail opens in turn",
      "do": "clickEach",
      "on": ".cst-railrow"
    },
    {
      "say": "back to Discover",
      "do": "click",
      "on": ".cst-railrow[data-view=\"\"]"
    },
    {
      "say": "the hero's page opens",
      "do": "click",
      "on": ".cst-hero .cst-name"
    },
    {
      "say": "back from the hero's page",
      "do": "click",
      "on": ".cst-back"
    },
    {
      "say": "the supporter pack's page opens",
      "do": "click",
      "on": ".cst-card:has-text(\"Lantern Pack\") .cst-card-name"
    },
    {
      "say": "back from the supporter pack",
      "do": "click",
      "on": ".cst-back"
    },
    {
      "say": "the limited drop's page opens",
      "do": "click",
      "on": ".cst-poster:has-text(\"Comet Drop\") .cst-poster-name"
    },
    {
      "say": "back from the limited drop",
      "do": "click",
      "on": ".cst-back"
    },
    {
      "say": "the Sparks pack's page opens",
      "do": "click",
      "on": ".cst-poster:has-text(\"Ember Deck\") .cst-poster-name"
    },
    {
      "say": "back from the Sparks pack",
      "do": "click",
      "on": ".cst-back"
    },
    {
      "say": "the icon pack's page opens, with two pictures",
      "do": "click",
      "on": ".cst-card:has-text(\"Dusk Icons\") .cst-card-name"
    },
    {
      "say": "the second picture is shown",
      "do": "click",
      "on": ".cgal-gal-next"
    },
    {
      "say": "the picture opens full screen",
      "do": "click",
      "on": ".cgal-gal-zoom"
    },
    {
      "say": "the next picture in the zoom",
      "do": "press",
      "key": "ArrowRight"
    },
    {
      "say": "the zoom closes",
      "do": "press",
      "key": "Escape"
    },
    {
      "say": "Esc leaves the icon pack's page",
      "do": "press",
      "key": "Escape"
    },
    {
      "say": "the supporters' sheet opens",
      "do": "click",
      "on": ".cst-band-keys .cst-plain"
    },
    {
      "say": "the supporters' sheet closes",
      "do": "click",
      "on": ".cst-info .cst-close"
    },
    {
      "say": "a shelf moves on",
      "do": "click",
      "on": ".cst-step:not([disabled])"
    },
    {
      "say": "a search that finds something",
      "do": "fill",
      "on": ".cst-search",
      "text": "clock"
    },
    {
      "say": "the results are drawn",
      "do": "wait",
      "ms": 800
    },
    {
      "say": "a search that finds nothing",
      "do": "fill",
      "on": ".cst-search",
      "text": "zzqq"
    },
    {
      "say": "nothing found is drawn",
      "do": "wait",
      "ms": 800
    },
    {
      "say": "Discover empties the search",
      "do": "click",
      "on": ".cst-railrow[data-view=\"\"]"
    },
    {
      "say": "the widgets list opens",
      "do": "click",
      "on": ".cst-railrow[data-view=\"widget\"]"
    },
    {
      "say": "every order of the list in turn",
      "do": "chooseEach",
      "on": ".cgal-select-el"
    },
    {
      "say": "Esc closes the Store",
      "do": "press",
      "key": "Escape"
    }
  ]
}
