{
  "name": "xenon-edge-widget",
  "version": "4.11.7",
  "description": "A self-contained local dashboard for any second screen — a monitor, a touchscreen, a paired phone or tablet, a CORSAIR Xeneon Edge: media controls, audio devices, microphone mute, calendar, notes and live system stats, on Windows, macOS and Linux.",
  "private": true,
  "main": "server/server.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test \"server/test/*.test.mjs\" \"packages/core/test/*.test.mjs\"",
    "dev": "node tools/dev.mjs",
    "demo": "node tools/build-demo.mjs && node tools/preview-docs.cjs",
    "demo:build": "node tools/build-demo.mjs",
    "link:shared": "node tools/link-shared.mjs",
    "check:platform-apis": "node tools/check-platform-apis.mjs",
    "doctor": "node tools/doctor.mjs",
    "version:set": "node tools/set-version.mjs",
    "postinstall": "node tools/link-shared.mjs",
    "native:dev": "node tools/dev.mjs --native",
    "native:build": "npm run build --workspace @xenon/native",
    "icue:validate": "icuewidget validate widget",
    "icue:package": "node tools/package-icue-widget.mjs"
  },
  "engines": {
    "node": ">=18.15.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcimastro98/Xenon.git"
  },
  "keywords": [
    "corsair",
    "icue",
    "xeneon-edge",
    "widget",
    "windows",
    "dashboard",
    "system-monitor",
    "spotify",
    "microphone"
  ],
  "dependencies": {
    "koffi": "^3.0.2",
    "msedge-tts": "^2.0.5",
    "ws": "^8.21.0"
  }
}
